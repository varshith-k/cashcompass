# Placeholders only — never commit real values. Copy to .env.local (git-ignored).

# Auth0 — Regular Web Application (see docs/AUTH0_SETUP.md).
# Leave all four AUTH0_* values empty to run locally in demo mode (DEMO_USER, no sign-in).
# Tenant domain, no scheme, e.g. cashcompass.us.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# Server-only secret. Never prefix with NEXT_PUBLIC_.
AUTH0_CLIENT_SECRET=
# Encrypts the session cookie. Generate with: openssl rand -hex 32 (different per environment)
AUTH0_SECRET=
# Public origin. http://localhost:3000 locally, https://<your-domain> in production.
# Leave unset on preview deployments to infer it from the request host.
APP_BASE_URL=http://localhost:3000
# Optional: let users edit their display name in Settings (needs Management API access, see docs/AUTH0_SETUP.md).
AUTH0_PROFILE_EDITING=false
# Only if AUTH0_DOMAIN is a custom domain: your canonical tenant domain, e.g. cashcompass.us.auth0.com
AUTH0_MANAGEMENT_DOMAIN=
# Set to true only after Auth0's "Require Multi-factor Auth" is Always (docs/AUTH0_SETUP.md §7).
# Auth0 enforces two-step verification; this only updates the Settings page.
AUTH0_MFA_REQUIRED=false

# Tiger Data (TimescaleDB on Postgres) — financial events and analytics.
# See src/lib/finance/README.md. Unset = demo in-memory data.
DATABASE_URL=

# Gemini financial copilot
GEMINI_API_KEY=
# Shared by the copilot and photo extraction; override when model availability changes.
GEMINI_MODEL=gemini-3.6-flash

# Settle Up email notifications via Resend (https://resend.com). Optional: without them,
# reminders open a pre-filled email in the user's own mail app.
# EMAIL_FROM must use a domain verified in Resend (e.g. cashcompass.club); without a
# verified domain Resend only delivers to your own account address.
RESEND_API_KEY=
EMAIL_FROM=CashCompass <notify@cashcompass.club>
# Bill email reminders: shared secret for the hourly job (POST /api/public/cron/bill-reminders).
# Generate with: openssl rand -hex 32. Unset = reminders are never sent.
CRON_SECRET=

# Capital One Nessie demo data (see src/lib/nessie/README.md)
NESSIE_API_KEY=
NESSIE_API_BASE_URL=https://api.nessieisreal.com
# Customer enables a chooser for its accounts; a fixed account also works.
NESSIE_CUSTOMER_ID=
NESSIE_ACCOUNT_ID=

# Solana "Pay with Solana" ledger settlement (devnet demo).
# See src/lib/solana/README.md. Unset = uses the generated demo address in config.ts.
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com
SOLANA_DEMO_RECIPIENT_ADDRESS=

# Optional MoneyQuest URL override. Empty uses the owner's game page (place 73262786586748).
# Direct HTTPS Roblox /games/<place-id> URLs only; invalid overrides use the owner's page.
# Public configuration: rebuild Next.js after changing it. See roblox/moneyquest/README.md.
NEXT_PUBLIC_ROBLOX_MONEYQUEST_URL=

# DeepSpace Live Split Room (separate app, not this codebase - see
# cashcompass-split-room/). Server-only: rendered into a link, never sent to
# the browser as an env var. Unset falls back to the deployed instance.
DEEPSPACE_SPLIT_ROOM_URL=https://cashcompass-split-room.app.space/split

# Optional isolated Tiger recovery drill. These must be two separate services,
# with hosts distinct from DATABASE_URL and each other. Never point the app at them.
TIGER_DRILL_DATABASE_URL=
TIGER_RECOVERY_DATABASE_URL=
